diff --git a/src/backend/flatpak.rs b/src/backend/flatpak.rs
index c541499..77426ec 100644
--- a/src/backend/flatpak.rs
+++ b/src/backend/flatpak.rs
@@ -622,12 +622,39 @@ impl Backend for Flatpak {
             }
             OperationKind::RepositoryAdd(adds) => {
                 drop(tx);
-                let mut remotes = Vec::with_capacity(adds.len());
-                for add in adds.iter() {
-                    remotes.push(Remote::from_file(&add.id, &glib::Bytes::from(&add.data))?);
-                }
-                for remote in remotes {
-                    inst.add_remote(&remote, true, Cancellable::NONE)?;
+                if self.user {
+                    let mut remotes = Vec::with_capacity(adds.len());
+                    for add in adds.iter() {
+                        remotes.push(Remote::from_file(&add.id, &glib::Bytes::from(&add.data))?);
+                    }
+                    for remote in remotes {
+                        inst.add_remote(&remote, true, Cancellable::NONE)?;
+                    }
+                } else {
+                    // Recommended sources are now system-scope. Their repo
+                    // files are package-owned and the helper accepts only an
+                    // allowlisted name, reading the file itself -- a user's
+                    // imported .flatpakrepo never reaches root.
+                    for add in adds.iter() {
+                        let output = std::process::Command::new("/usr/bin/pkexec")
+                            .arg("/usr/libexec/cosmic-store-flatpak-remote")
+                            .arg("add")
+                            .arg(&add.id)
+                            .output()?;
+                        if !output.status.success() {
+                            let stderr = String::from_utf8_lossy(&output.stderr);
+                            let detail = if stderr.trim().is_empty() {
+                                format!("exit status {}", output.status)
+                            } else {
+                                stderr.trim().to_string()
+                            };
+                            return Err(format!(
+                                "failed to add system flatpak remote {}: {}",
+                                add.id, detail
+                            )
+                            .into());
+                        }
+                    }
                 }
                 return Ok(());
             }
