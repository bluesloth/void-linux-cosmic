#!/bin/sh
# cosmic-store-flatpak-remote -- root-only helper for system Flatpak remotes.
#
# Why this exists: COSMIC Store's "Manage repositories" panel works with
# system-scope remotes (the installer provisions Flathub system-wide), but
# /var/lib/flatpak is not writable by an unprivileged process. The store
# delegates Add and Remove on those remotes to this package-owned script
# through pkexec. Custom .flatpakrepo files imported by the user are NOT
# handled here: they stay user-scope, so no caller-chosen URL or key ever
# reaches root.
#
# Policy: two actions, both auth_admin, annotate this exact path with
# argv1="add" and argv1="remove" respectively. This helper re-validates
# every argument itself: exactly two args, verb in {add,remove}, name in
# {flathub,cosmic}. For `add` it reads the repository file from a
# package-owned directory -- it never accepts a path, URL or key from the
# caller, so no caller-chosen flags can reach flatpak.

set -u

if [ "$(id -u 2>/dev/null || echo 1)" -ne 0 ]; then
	echo "cosmic-store-flatpak-remote: must run as root (through pkexec)" >&2
	exit 1
fi

if [ "$#" -ne 2 ]; then
	echo "cosmic-store-flatpak-remote: expected 'add|remove <name>'" >&2
	exit 2
fi

verb=$1
name=$2

case "$verb" in
add | remove) ;;
*)
	echo "cosmic-store-flatpak-remote: unsupported operation: $verb" >&2
	exit 2
	;;
esac

case "$name" in
flathub | cosmic) ;;
*)
	echo "cosmic-store-flatpak-remote: remote not allowed: $name" >&2
	exit 3
	;;
esac

case "$verb" in
add)
	repo_file="/usr/share/cosmic-store/flatpakrepo/$name.flatpakrepo"
	if [ ! -r "$repo_file" ]; then
		echo "cosmic-store-flatpak-remote: missing packaged repo file for $name" >&2
		exit 4
	fi
	exec /usr/bin/flatpak remote-add --system --if-not-exists "$name" "$repo_file"
	;;
remove)
	# The store's installed-refs guard runs first; --force is deliberately
	# not used, so a remote that still has refs cannot be removed behind
	# flatpak's back.
	exec /usr/bin/flatpak remote-delete --system "$name"
	;;
esac
